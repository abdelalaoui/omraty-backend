# Copier ce fichier en `.env` (ou exporter ces variables autrement) puis lancer :
#   createdb omraty
#   ./gradlew bootRun
# Toutes les variables ont une valeur par défaut adaptée au développement local dans
# application.yml, sauf DB_PASSWORD/JWT_SECRET (à définir dans chaque environnement).

# --- Base de données (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/omraty
DB_USERNAME=omraty
DB_PASSWORD=changeme

# --- Serveur ---
SERVER_PORT=8080

# --- Authentification (JWT) ---
JWT_SECRET=change-me-in-every-environment-min-32-chars
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=30

# --- Paiement (Moov) ---
# mock (par défaut, dev/test : voir MockPaymentGatewayClient/NoOpWebhookVerifier, aucun appel
# externe, aucune vérification de signature de webhook) | moov (implémentation réelle une fois
# MoovPaymentGatewayClient/MoovWebhookVerifier écrites).
PAYMENT_GATEWAY_PROVIDER=mock
# Fréquence (ms) du job de vérification de secours des paiements PENDING (PendingPaymentCheckTask).
PAYMENT_PENDING_CHECK_INTERVAL_MS=60000

# --- VIP ---
# Délai (heures) avant expiration automatique d'une offre VIP proposée et non répondue.
VIP_OFFER_EXPIRATION_HOURS=24

# --- Notifications push (Firebase Cloud Messaging) ---
# Optionnel : sans cette variable, l'app démarre normalement et les notifications push sont
# simplement désactivées (voir FirebaseConfig). Contenu JSON de la clé de compte de service
# Firebase (Firebase Console > Paramètres du projet > Comptes de service > Générer une nouvelle clé
# privée), ou chemin vers ce fichier JSON.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Stockage des fichiers (photos d'identité, etc.) ---
# local (par défaut, dev : fichiers écrits sous UPLOAD_DIR) | s3 (nécessite les variables AWS_*
# ci-dessous).
UPLOAD_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads
# Requis seulement si UPLOAD_PROVIDER=s3. Credentials résolues via la chaîne standard AWS
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY), jamais codées en dur dans le code.
AWS_S3_BUCKET=changeme
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
